<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Worksheet</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>   <thead> <tr class="over_header"> <th aria-label="" data-stat="" colspan="4" class=" over_header center"></th> <th aria-label="" data-stat="header_playing" colspan="4" class=" over_header center group_start">Playing Time</th> <th aria-label="" data-stat="header_performance" colspan="10" class=" over_header center group_start">Performance</th> <th aria-label="" data-stat="header_pk" colspan="5" class=" over_header center group_start">Penalty Kicks</th><th></th> </tr> <tr> <th aria-label="Player" data-stat="player" scope="col" class=" poptip sort_default_asc left">Player</th> <th aria-label="Nation" data-stat="nationality" scope="col" class=" poptip sort_default_asc center" data-tip="Nationality of the player.&lt;br&gt;First, we check our records in international play at senior level.&lt;br&gt;Then youth level.&lt;br&gt;Then citizenship presented on wikipedia.&lt;br&gt;Finally, we use their birthplace when available.">Nation</th> <th aria-label="Position" data-stat="position" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Position&lt;/strong&gt;&lt;br&gt;Position most commonly played by the player&lt;br&gt;GK - Goalkeepers&lt;br&gt;DF - Defenders&lt;br&gt;MF - Midfielders&lt;br&gt;FW - Forwards&lt;br&gt;FB - Fullbacks&lt;br&gt;LB - Left Backs&lt;br&gt;RB - Right Backs&lt;br&gt;CB - Center Backs&lt;br&gt;DM - Defensive Midfielders&lt;br&gt;CM - Central Midfielders&lt;br&gt;LM - Left Midfielders&lt;br&gt;RM - Right Midfielders&lt;br&gt;WM - Wide Midfielders&lt;br&gt;LW - Left Wingers&lt;br&gt;RW - Right Wingers&lt;br&gt;AM - Attacking Midfielders&lt;br&gt;">Pos</th> <th aria-label="Age" data-stat="age" scope="col" class=" poptip sort_default_asc center" data-tip="Age at season start&lt;br&gt;Given on August 1 for winter leagues&lt;br&gt;and February 1 for summer leagues.">Age</th> <th aria-label="Matches Played" data-stat="gk_games" scope="col" class=" poptip center group_start" data-tip="&lt;strong&gt;Matches Played&lt;/strong&gt;&lt;br&gt;Matches Played by the player or squad" data-over-header="Playing Time">MP</th> <th aria-label="Starts" data-stat="gk_games_starts" scope="col" class=" poptip center" data-tip="Game or games started by player" data-over-header="Playing Time">Starts</th> <th aria-label="Minutes" data-stat="gk_minutes" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Minutes&lt;/strong&gt;&lt;br&gt;" data-over-header="Playing Time">Min</th> <th aria-label="90s Played" data-stat="minutes_90s" scope="col" class=" poptip center" data-tip="&lt;strong&gt;90s Played&lt;/strong&gt;&lt;br&gt;&lt;strong&gt;90s played&lt;/strong&gt;&lt;br&gt;Minutes played divided by 90" data-over-header="Playing Time">90s</th> <th aria-label="Goals Against" data-stat="gk_goals_against" scope="col" class=" poptip center group_start" data-tip="&lt;strong&gt;Goals Against&lt;/strong&gt;&lt;br&gt;Goals Against" data-over-header="Performance">GA</th> <th aria-label="Goals Against/90" data-stat="gk_goals_against_per90" scope="col" class=" poptip sort_default_asc hide_non_quals center" data-tip="&lt;strong&gt;Goals Against/90&lt;/strong&gt;&lt;br&gt;Goals Against per 90 minutes" data-over-header="Performance" data-filter="1" data-name="Goals Against/90">GA90</th> <th aria-label="Shots on Target Against" data-stat="gk_shots_on_target_against" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Shots on Target Against&lt;/strong&gt;&lt;br&gt;Shots on Target Against" data-over-header="Performance">SoTA</th> <th aria-label="Saves" data-stat="gk_saves" scope="col" class=" poptip center" data-over-header="Performance">Saves</th> <th aria-label="Save Percentage" data-stat="gk_save_pct" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Save Percentage&lt;/strong&gt;&lt;br&gt;Save Percentage&lt;br&gt;(Shots on Target Against - Goals Against)/Shots on Target Against&lt;br&gt;Note that not all shots on target are stopped by the keeper, many will be stopped by defenders" data-over-header="Performance" data-filter="1" data-name="Save Percentage">Save%</th> <th aria-label="Wins" data-stat="gk_wins" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Wins&lt;/strong&gt;&lt;br&gt;Wins" data-over-header="Performance">W</th> <th aria-label="Draws" data-stat="gk_ties" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Draws&lt;/strong&gt;&lt;br&gt;Draws" data-over-header="Performance">D</th> <th aria-label="Losses" data-stat="gk_losses" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Losses&lt;/strong&gt;&lt;br&gt;Losses" data-over-header="Performance">L</th> <th aria-label="Clean Sheets" data-stat="gk_clean_sheets" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Clean Sheets&lt;/strong&gt;&lt;br&gt;Clean Sheets&lt;br&gt;Full matches by goalkeeper where no goals are allowed." data-over-header="Performance">CS</th> <th aria-label="Clean Sheet Percentage" data-stat="gk_clean_sheets_pct" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Clean Sheet Percentage&lt;/strong&gt;&lt;br&gt;Clean Sheet Percentage&lt;br&gt;Percentage of matches that result in clean sheets." data-over-header="Performance" data-filter="1" data-name="Clean Sheet Percentage">CS%</th> <th aria-label="Penalty Kicks Attempted" data-stat="gk_pens_att" scope="col" class=" poptip center group_start" data-tip="&lt;strong&gt;Penalty Kicks Attempted&lt;/strong&gt;&lt;br&gt;Penalty Kicks Attempted" data-over-header="Penalty Kicks">PKatt</th> <th aria-label="Penalty Kicks Allowed" data-stat="gk_pens_allowed" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Penalty Kicks Allowed&lt;/strong&gt;&lt;br&gt;Penalty Kicks Allowed" data-over-header="Penalty Kicks">PKA</th> <th aria-label="Penalty Kicks Saved" data-stat="gk_pens_saved" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Penalty Kicks Saved&lt;/strong&gt;&lt;br&gt;Penalty Kicks Saved" data-over-header="Penalty Kicks">PKsv</th> <th aria-label="Penalty Kicks Missed" data-stat="gk_pens_missed" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Penalty Kicks Missed&lt;/strong&gt;&lt;br&gt;Penalty Kicks Missed" data-over-header="Penalty Kicks">PKm</th> <th aria-label="Save% (Penalty Kicks)" data-stat="gk_pens_save_pct" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Save% (Penalty Kicks)&lt;/strong&gt;&lt;br&gt;Penalty Save Percentage&lt;br&gt;Penalty Kick Goals Against/Penalty Kick Attempts&lt;br&gt;Penalty shots that miss the target are not included" data-over-header="Penalty Kicks" data-filter="1" data-name="Save% (Penalty Kicks)">Save%</th> <th aria-label="Matches" data-stat="matches" scope="col" class=" poptip center group_start">Matches</th> </tr> </thead> <tbody> <tr data-row="0"><th scope="row" class="left " data-append-csv="6a713852" data-stat="player" csk="Sánchez Robert">Robert Sánchez</th><td class="left poptip" data-stat="nationality" data-tip="NT">es ESP</td><td class="center " data-stat="position" csk="1.0">GK</td><td class="center " data-stat="age">27</td><td class="right group_start" data-stat="gk_games">35</td><td class="right " data-stat="gk_games_starts">35</td><td class="right " data-stat="gk_minutes" csk="3039">3,039</td><td class="right " data-stat="minutes_90s">33.8</td><td class="right group_start" data-stat="gk_goals_against">49</td><td class="right " data-stat="gk_goals_against_per90">1.45</td><td class="right " data-stat="gk_shots_on_target_against">147</td><td class="right " data-stat="gk_saves">97</td><td class="right " data-stat="gk_save_pct">66.7</td><td class="right " data-stat="gk_wins">13</td><td class="right " data-stat="gk_ties">8</td><td class="right " data-stat="gk_losses">14</td><td class="right " data-stat="gk_clean_sheets">9</td><td class="right " data-stat="gk_clean_sheets_pct">25.7</td><td class="right group_start" data-stat="gk_pens_att">2</td><td class="right " data-stat="gk_pens_allowed">2</td><td class="right iz" data-stat="gk_pens_saved">0</td><td class="right iz" data-stat="gk_pens_missed">0</td><td class="right iz" data-stat="gk_pens_save_pct">0.0</td><td class="left group_start" data-stat="matches">Matches</td></tr> <tr data-row="1"><th scope="row" class="left " data-append-csv="0107757e" data-stat="player" csk="Jørgensen Filip">Filip Jørgensen</th><td class="left poptip" data-stat="nationality" data-tip="NT">dk DEN</td><td class="center " data-stat="position" csk="1.0">GK</td><td class="center " data-stat="age">23</td><td class="right group_start" data-stat="gk_games">5</td><td class="right " data-stat="gk_games_starts">3</td><td class="right " data-stat="gk_minutes" csk="379">379</td><td class="right " data-stat="minutes_90s">4.2</td><td class="right group_start" data-stat="gk_goals_against">5</td><td class="right " data-stat="gk_goals_against_per90">1.19</td><td class="right " data-stat="gk_shots_on_target_against">13</td><td class="right " data-stat="gk_saves">8</td><td class="right " data-stat="gk_save_pct">61.5</td><td class="right " data-stat="gk_wins">1</td><td class="right " data-stat="gk_ties">2</td><td class="right iz" data-stat="gk_losses">0</td><td class="right iz" data-stat="gk_clean_sheets">0</td><td class="right iz" data-stat="gk_clean_sheets_pct">0.0</td><td class="right iz group_start" data-stat="gk_pens_att">0</td><td class="right iz" data-stat="gk_pens_allowed">0</td><td class="right iz" data-stat="gk_pens_saved">0</td><td class="right iz" data-stat="gk_pens_missed">0</td><td class="right iz" data-stat="gk_pens_save_pct"></td><td class="left group_start" data-stat="matches">Matches</td></tr> </tbody>